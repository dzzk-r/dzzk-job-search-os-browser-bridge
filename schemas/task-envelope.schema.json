{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execution-delivery-harness.local/schemas/task-envelope.schema.json",
  "title": "Execution Delivery Harness Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "plan_id",
    "goal",
    "evidence",
    "scope",
    "constraints",
    "acceptance",
    "risk_class",
    "budget",
    "escalation_conditions",
    "artifacts",
    "source",
    "execution_profile"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "parent_task_id": { "type": ["string", "null"] },
    "goal": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "summary"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes", "tools"],
      "properties": {
        "reads": { "type": "array", "items": { "type": "string" } },
        "writes": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "evidence_required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "evidence_required": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risk_class": {
      "type": "string",
      "enum": ["low", "medium", "high", "requires_user_decision"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_seconds"],
      "properties": {
        "deadline_seconds": { "type": "integer", "minimum": 1 },
        "max_agent_steps": { "type": ["integer", "null"], "minimum": 1 },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "max_repairs": { "type": "integer", "minimum": 0, "default": 1 }
      }
    },
    "escalation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_dir", "expected"],
      "properties": {
        "run_dir": { "type": "string", "minLength": 1 },
        "expected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client"],
      "properties": {
        "client": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": ["string", "null"] },
        "turn_id": { "type": ["string", "null"] },
        "message_id": { "type": ["string", "null"] },
        "locator": { "type": ["string", "null"] }
      }
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor"],
      "properties": {
        "executor": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "runtime": { "type": ["string", "null"] }
      }
    }
  }
}
