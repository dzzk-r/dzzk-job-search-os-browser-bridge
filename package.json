{
  "name": "execution-delivery-harness",
  "version": "0.1.10",
  "description": "Controlled delivery of agent actions into user-owned browser and local execution environments.",
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test tests/*.mjs",
    "lint": "web-ext lint --source-dir firefox --warnings-as-errors",
    "build": "web-ext build --source-dir firefox --artifacts-dir dist --overwrite-dest",
    "test:firefox": "node scripts/firefox-smoke.mjs",
    "knowledge:query": "node scripts/knowledge.mjs query",
    "knowledge:context": "node scripts/knowledge.mjs context",
    "project:readiness": "node scripts/project-context.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzzk-r/execution-delivery-harness.git"
  },
  "keywords": [],
  "author": "Daniel Chechik (dzzk)",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dzzk-r/execution-delivery-harness/issues"
  },
  "homepage": "https://github.com/dzzk-r/execution-delivery-harness#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "selenium-webdriver": "4.50.0",
    "web-ext": "10.7.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
