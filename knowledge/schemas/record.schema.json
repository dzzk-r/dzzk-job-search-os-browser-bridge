{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.execution-delivery-harness/knowledge-record.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "summary",
    "status",
    "tags",
    "entities",
    "evidence",
    "created_at",
    "updated_at",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "kind": {
      "enum": [
        "claim",
        "decision",
        "runbook",
        "constraint",
        "lesson"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "tentative",
        "rejected"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "enum": [
              "test",
              "file",
              "commit",
              "command",
              "observation",
              "doc",
              "chat"
            ]
          },
          "ref": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "required": [
        "scope",
        "repo",
        "task_ids",
        "source_artifacts"
      ],
      "properties": {
        "scope": {
          "enum": [
            "task",
            "repository",
            "global"
          ]
        },
        "repo": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "worktree": {
              "type": [
                "string",
                "null"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "head": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
